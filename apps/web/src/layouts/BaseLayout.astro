---
import { localeDirection, type SupportedLocale } from '@edu-hub/config';
import { canonicalUrl, localeAlternates } from '@edu-hub/seo';
import '../styles/global.css';

interface Props {
  locale: SupportedLocale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const origin = import.meta.env.PUBLIC_WEB_ORIGIN ?? 'http://localhost:4321';
const canonical = canonicalUrl(origin, locale);
const alternates = localeAlternates(origin);
---

<!doctype html>
<html lang={locale} dir={localeDirection(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href={canonical} />
    {
      alternates.map(({ locale: alternateLocale, href }) => (
        <link rel="alternate" hreflang={alternateLocale} href={href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={canonicalUrl(origin, 'en-EG')}
    />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
