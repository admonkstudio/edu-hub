{
  "name": "edu-hub",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @edu-hub/web dev",
    "dev:control": "pnpm --filter @edu-hub/control dev",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @edu-hub/web build",
    "build:control": "pnpm --filter @edu-hub/control build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:db": "supabase test db --local supabase/tests",
    "test:browser": "playwright test",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types --lang typescript --local > packages/database/src/database.types.ts",
    "db:fixtures": "supabase db query --local --file supabase/fixtures/representative.sql"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "eslint": "9.35.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "16.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "supabase": "2.114.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.42.0",
    "vitest": "4.1.10"
  }
}
